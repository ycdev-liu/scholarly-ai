# Application
MODE=dev
HOST=0.0.0.0
PORT=8080
AGENT_URL=http://127.0.0.1:8080
LOG_LEVEL=INFO
AUTH_SECRET=

# Model provider
# The fake model makes a fresh checkout bootable without credentials.
# For real usage, set USE_FAKE_MODEL=false and configure one provider below.
USE_FAKE_MODEL=true
DEFAULT_MODEL=fake
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenAI-compatible providers
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Ollama (set OLLAMA_MODEL to enable this provider)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Embeddings and vector database
USE_LOCAL_MODEL=true
LOCAL_MODEL_NAME=BAAI/bge-small-en-v1.5
# Leave empty to use the legacy USE_LOCAL_MODEL setting; or choose local, openai, dashscope.
EMBEDDING_PROVIDER=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_API_KEY=
# Optional: the API Host shown when creating a Model Studio key.
# DASHSCOPE_HTTP_BASE_URL=https://your-api-host/api/v1
VECTOR_DB_TYPE=chroma
CHROMA_DB_PATH=./data/vector_databases/default_chroma
QDRANT_PATH=./data/vector_databases/default_qdrant
QDRANT_URL=
QDRANT_COLLECTION=documents
OPENREVIEW_DOWNLOAD_DIR=./data/downloads/papers

# Optional local stdio MCP servers used by literature-review.
# JSON maps server names to stdio connection settings; tools must also be allowlisted.
MCP_RESEARCH_SERVERS={}
MCP_RESEARCH_ALLOWED_TOOLS={}

# Conversation memory. SQLite requires no external database.
DATABASE_TYPE=sqlite
CHECKPOINTER_DB_TYPE=sqlite
STORE_DB_TYPE=sqlite
SQLITE_DB_PATH=./data/checkpoints.db

# Optional PostgreSQL memory backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agent_store

# Optional MongoDB checkpoint backend
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=agent_checkpoints
MONGO_AUTH_SOURCE=admin

# Optional observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=scholarly-ai
LANGCHAIN_API_KEY=
LANGFUSE_TRACING=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
