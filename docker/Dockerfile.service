FROM python:3.12.3-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

COPY pyproject.toml .
COPY uv.lock .
RUN pip install --no-cache-dir uv
RUN uv sync --frozen --no-install-project --no-dev --extra pageindex

COPY backend/app/agents/ ./agents/
COPY backend/app/core/ ./core/
COPY backend/app/memory/ ./memory/
COPY backend/app/schema/ ./schema/
COPY backend/app/service/ ./service/
COPY backend/app/run_service.py .

# Create data directory for SQLite database
RUN mkdir -p /app/data/vector_databases
# 统一历史 data 路径与上传接口使用的 vector_databases 路径，并由 compose 持久化。
RUN ln -s /app/data/vector_databases /app/vector_databases

CMD ["sh", "-c", "mkdir -p /app/data/vector_databases && exec python run_service.py"]
